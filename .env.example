# Copy to .env for local development: cp .env.example .env
NODE_ENV=development
PORT=3000

# Local MySQL from docker-compose.yml
DATABASE_URL=mysql://vanguard:change-me-local-only@127.0.0.1:3306/vanguard_ess

# Any random string for local dev
JWT_SECRET=local-dev-only-insecure-secret-change-me

FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Google OAuth — optional for local dev. Leave blank and use the
# "Preview synthetic dataset (read-only)" button on the sign-in screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
